{
  "name": "nuxt-agentic",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "^22.22.3 || >=24.15.0",
    "pnpm": ">=10.33.0"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' run build",
    "typecheck": "pnpm build && pnpm -r --if-present run typecheck",
    "test": "pnpm build && pnpm -r --if-present run test",
    "lint": "eslint . --max-warnings=0",
    "lint:packages": "pnpm build && pnpm -r --filter './packages/**' run lint:package && pnpm -r --filter './packages/**' run lint:types",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.1",
    "@cloudflare/workers-types": "5.20261015.1",
    "@nuxt/eslint-config": "1.17.0",
    "@types/node": "22.20.4",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9",
    "publint": "0.3.25",
    "tsdown": "0.23.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vue-tsc": "^3.0.0"
  }
}
